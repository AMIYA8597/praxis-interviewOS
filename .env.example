# =============================================================================
# PRAXIS environment configuration
# Copy to `.env` and fill in. Every key maps 1:1 to packages/config/settings.py.
# NEVER commit real values. Production refuses to boot on unsafe settings
# (see Settings.validate_production).
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
# development | test | staging | production
#   production => API docs off, JSON logs, auth bypass impossible, strict CORS.
APP_ENV=development
# hard block on any billable provider call
ZERO_SPEND_MODE=true
# if true, cloud providers are never routed to
LOCAL_ONLY_MODE=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT=                   # json | text  (default: text in development, json elsewhere)

# ── Database (required) ──────────────────────────────────────────────────────
# postgresql:// or postgresql+asyncpg:// (converted automatically).
# Schema: `python scripts/migrate.py` (or `alembic upgrade head` from backend/).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/praxis
# Pool sizing is PER PROCESS. API workers x (POOL_SIZE + MAX_OVERFLOW) must stay
# below Postgres max_connections (Supabase free tier: use the pooler URL).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# seconds to wait for a free connection
DB_POOL_TIMEOUT_S=30
# recycle connections older than this (pgbouncer/LB idle timeouts)
DB_POOL_RECYCLE_S=1800
# drop dead connections transparently
DB_POOL_PRE_PING=true
# server-side statement timeout per connection (0 = off)
DB_STATEMENT_TIMEOUT_MS=15000
# log SQL (never in production)
DB_ECHO=false

# ── Supabase / authentication ────────────────────────────────────────────────
# JWTs are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# (cached in Redis for JWKS_CACHE_TTL_S, refreshed on unknown `kid`).
# Required in production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-side only; required if STORAGE_BACKEND=supabase
SUPABASE_SERVICE_ROLE_KEY=
# only for legacy HS256 projects (Settings > API > JWT secret)
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
# JWT_ISSUER=                   # default: ${SUPABASE_URL}/auth/v1
# clock-skew tolerance for exp/iat
JWT_LEEWAY_S=30
JWKS_CACHE_TTL_S=3600
# min seconds between forced JWKS refreshes (anti-abuse)
JWKS_REFRESH_COOLDOWN_S=60
# cache of auth user -> candidate id
CANDIDATE_CACHE_TTL_S=900
# Development only: when no verifier is configured, every bearer token maps to
# AUTH_DEV_USER_ID. Leave unset for "auto" (on only in development without
# SUPABASE_URL). Setting it to true in production aborts startup.
# AUTH_DEV_BYPASS=
# AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated explicit origins. "*" is rejected in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
# ENABLE_API_DOCS=              # default: on except in production
ENABLE_RATE_LIMIT=true

# ── Redis / background jobs (required) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# per process; ~10 for free-tier hosted Redis
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT_S=5
REDIS_HEALTH_CHECK_INTERVAL_S=30
ARQ_QUEUE_NAME=arq:queue
# concurrent jobs per worker process
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_S=300
# attempts before a job is written to failed_jobs
WORKER_MAX_TRIES=3

# ── Storage / uploads ────────────────────────────────────────────────────────
# local | supabase
STORAGE_BACKEND=local
# used when STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# used when STORAGE_BACKEND=supabase
STORAGE_BUCKET=documents
# 10 MB resume limit (413 above this)
MAX_UPLOAD_BYTES=10485760

# ── AI providers ─────────────────────────────────────────────────────────────
MODELS_CONFIG_PATH=config/models.yaml
OLLAMA_BASE_URL=http://localhost:11434
# 384-dim; must match vector(384)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_STT_MODEL=small.en
LOCAL_TTS_VOICE=en_US-lessac-medium
# Free-tier cloud (optional)
GROQ_API_KEY=
GEMINI_API_KEY=
# BYO paid providers (optional, default OFF; first paid use requires consent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ── Realtime agent ───────────────────────────────────────────────────────────
# time allowed for the first-frame {"type":"auth"} message
WS_AUTH_TIMEOUT_S=10
# dropped sessions can resume within this window
WS_RECONNECT_GRACE_S=30
# silence after a question before a nudge
TURN_NO_ANSWER_TIMEOUT_S=20
# nudges before the interviewer moves on
TURN_MAX_NUDGES=1

# ── Observability ────────────────────────────────────────────────────────────
# Tracing turns on when OTEL_ENABLED=true (or when the endpoint is set explicitly).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=            # default per process: praxis-core-api / praxis-worker / praxis-realtime-agent
# optional
SENTRY_DSN=

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED to store BYO provider API keys
FERNET_KEY=

# ── Free-tier budget ─────────────────────────────────────────────────────────
FREE_TIER_MODE=true
FREE_TIER_BUDGET_DAILY_USD=0.50
