# # ── Core ──────────────────────────────────────────────
# APP_ENV=development
# ZERO_SPEND_MODE=true          # hard block on any billable provider call
# LOCAL_ONLY_MODE=true          # if true, cloud providers are never routed to

# # ── Database ──
# # Required for all environments. Points to the local Docker Postgres by default.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/praxis
# # Required ONLY when deploying or using cloud Supabase.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=     # Required for backend if STORAGE_BACKEND=supabase

# # ── Redis ──
# # Required for all environments (caching, sessions, queue).
# REDIS_URL=redis://localhost:6379/0
# REDIS_MAX_CONNECTIONS=10       # Recommend 10 for free-tier deployments

# # ── Storage ──
# # 'local' or 'supabase'. 'local' uses the filesystem (dev).
# STORAGE_BACKEND=local
# # Required if STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=./storage

# # ── Local AI (no keys needed) ──
# OLLAMA_BASE_URL=http://localhost:11434
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LOCAL_STT_MODEL=small.en        # faster-whisper size; see Phase 5
# LOCAL_TTS_VOICE=en_US-lessac-medium

# # ── Free-tier cloud (optional, get free API keys) ──
# GROQ_API_KEY=                   # console.groq.com — free tier, verify current limits
# GEMINI_API_KEY=                 # aistudio.google.com — free tier, verify current limits

# # ── BYO paid providers (optional, all default OFF) ──
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=

# # ── Observability ──
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=                     # optional

# # ── Secrets ──
# JWT_SECRET=                     # generate with `openssl rand -hex 32` (Windows: use `python -c "import secrets;print(secrets.token_hex(32))"`)
# FERNET_KEY=                     # REQUIRED for BYO API Keys. Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
