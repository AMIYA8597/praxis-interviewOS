{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "pnpm --filter web run build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm --filter web run dev",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.praxis.example.com/api/:path*"
    },
    {
      "source": "/realtime/:path*",
      "destination": "https://realtime.praxis.example.com/:path*"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.praxis.example.com https://api.praxis.example.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:;"
        }
      ]
    }
  ],

  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@praxis-supabase-url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@praxis-supabase-anon-key",
    "NEXT_PUBLIC_API_BASE_URL": "@praxis-api-base-url",
    "NEXT_PUBLIC_REALTIME_URL": "@praxis-realtime-url",
    "NEXT_PUBLIC_APP_ENV": "@praxis-app-env"
  }
}
