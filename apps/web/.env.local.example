# ── Backend API ──────────────────────────────────────────────────────────────
# Used by src/lib/api/client.ts and next.config.js rewrites.
# Local dev: http://localhost:8000
# Production: https://praxis-api-<hash>-<region>.a.run.app (your Cloud Run URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Realtime WebSocket ──────────────────────────────────────────────────────
# Used by src/lib/realtime/client.ts for live interview sessions.
# Local dev: ws://localhost:8080
# Production: wss://praxis-realtime-<hash>-<region>.a.run.app
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]

# ── Environment ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
