{
  "name": "praxis-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:desktop": "pnpm --filter desktop run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r run build",
    "build:desktop": "pnpm --filter desktop run build",
    "build:web": "pnpm --filter web run build",
    "test": "pnpm -r run test",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "pnpm -r exec tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.4.11",
    "electron-vite": "^5.0.0",
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.40.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^8.2.2"
  }
}
