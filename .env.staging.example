# =============================================================================
# PRAXIS — STAGING environment configuration
# Copy to: .env.staging (NEVER commit .env.staging)
# All secrets are in Google Secret Manager; this file is for local staging tests.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=staging
ZERO_SPEND_MODE=false
LOCAL_ONLY_MODE=false
LOG_LEVEL=INFO
# LOG_FORMAT=json   # JSON in staging matches production format

# ── Database ─────────────────────────────────────────────────────────────────
# Use Supabase staging project's connection string (session pooler, port 5432).
# Format: postgresql+asyncpg://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://STAGING_USER.STAGING_REF:STAGING_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Cloud Run: 2 conns/instance × 3 max instances = 6 max connections (well within Supabase free tier 60 limit).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE_S=300
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=10000
DB_ECHO=false

# ── Supabase ─────────────────────────────────────────────────────────────────
# Staging project — completely separate from production.
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=STAGING_SERVICE_ROLE_KEY
JWT_AUDIENCE=authenticated

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Allowed origins: staging frontend (if any), Electron dev build, test client.
# Never use "*" for authenticated APIs.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
ENABLE_RATE_LIMIT=true

# ── Redis ────────────────────────────────────────────────────────────────────
# Private Memorystore Redis URL (only reachable from VPC).
# Format when using TLS: rediss://REDIS_HOST:6380
REDIS_URL=redis://REDIS_HOST:6379/0
REDIS_MAX_CONNECTIONS=5
REDIS_SOCKET_TIMEOUT_S=5
ARQ_QUEUE_NAME=arq:queue
WORKER_MAX_JOBS=5
WORKER_JOB_TIMEOUT_S=300
WORKER_MAX_TRIES=3

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=supabase
STORAGE_BUCKET=documents-staging
MAX_UPLOAD_BYTES=10485760

# ── AI providers ─────────────────────────────────────────────────────────────
MODELS_CONFIG_PATH=config/models.yaml
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_STT_MODEL=base.en
# Cloud providers: keys stored in Secret Manager, not here.
GROQ_API_KEY=FROM_SECRET_MANAGER
OPENAI_API_KEY=FROM_SECRET_MANAGER

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com/v1/traces

# ── Security ─────────────────────────────────────────────────────────────────
FERNET_KEY=FROM_SECRET_MANAGER

# ── Budget ───────────────────────────────────────────────────────────────────
FREE_TIER_MODE=false
FREE_TIER_BUDGET_DAILY_USD=5.00
