# =============================================================================
# PRAXIS — PRODUCTION environment configuration
# Reference only — all actual secrets are in Google Secret Manager.
# This file documents required variables and their formats.
# NEVER put real production values in this file.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=production
ZERO_SPEND_MODE=false
LOCAL_ONLY_MODE=false
LOG_LEVEL=WARNING
# LOG_FORMAT=json  # always JSON in production

# ── Database ─────────────────────────────────────────────────────────────────
# Production Supabase project — DIFFERENT from staging.
# Supavisor session pooler (port 5432) only — NOT transaction pooler.
DATABASE_URL=postgresql+asyncpg://PROD_USER.PROD_REF:PROD_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Cloud Run: 2 conns × 10 max instances = 20 connections (Supabase Pro: 60 limit).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE_S=300
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=10000

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=PROD_ANON_KEY_FROM_SECRET_MANAGER
SUPABASE_SERVICE_ROLE_KEY=PROD_SERVICE_ROLE_KEY_FROM_SECRET_MANAGER
JWT_AUDIENCE=authenticated

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Only real production client origins. Never "*".
CORS_ALLOW_ORIGINS=https://app.praxis.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
ENABLE_RATE_LIMIT=true

# ── Redis ────────────────────────────────────────────────────────────────────
# Private Memorystore Redis with TLS.
REDIS_URL=rediss://PROD_REDIS_HOST:6380/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT_S=3
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_S=300
WORKER_MAX_TRIES=3

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=supabase
STORAGE_BUCKET=documents
MAX_UPLOAD_BYTES=10485760

# ── AI providers ─────────────────────────────────────────────────────────────
MODELS_CONFIG_PATH=config/models.yaml
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_STT_MODEL=base.en
GROQ_API_KEY=FROM_SECRET_MANAGER
OPENAI_API_KEY=FROM_SECRET_MANAGER

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=true
SENTRY_DSN=FROM_SECRET_MANAGER

# ── Security ─────────────────────────────────────────────────────────────────
FERNET_KEY=FROM_SECRET_MANAGER

# ── Budget ───────────────────────────────────────────────────────────────────
FREE_TIER_MODE=false
FREE_TIER_BUDGET_DAILY_USD=50.00
