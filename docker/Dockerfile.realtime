# syntax=docker/dockerfile:1.7
# ── praxis-realtime production image ─────────────────────────────────────────
# Build context: repository ROOT.
#
# IMPORTANT: This image is for the CLOUD RUN SERVER.
# - Server receives audio bytes from Electron clients; it does NOT capture local audio.
# - sounddevice, pyaudio, portaudio are NOT included (desktop-only).
# - torch/torchaudio are included (required for silero-vad and STT inference).
# - librosa is included (audio feature extraction for STT pipeline).
# - onnxruntime is included (silero-vad ONNX backend).

FROM python:3.11.11-slim AS deps

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1-dev \
    ffmpeg \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements/realtime.lock ./requirements-lock.txt
COPY packages/config/pyproject.toml packages/config/
COPY packages/ai-gateway/pyproject.toml packages/ai-gateway/
COPY backend/pyproject.toml backend/
COPY realtime-agent/pyproject.toml realtime-agent/

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip==24.3.1 && \
    pip install --no-cache-dir --require-hashes -r requirements-lock.txt

FROM deps AS source

COPY packages/ packages/
COPY backend/ backend/
COPY realtime-agent/ realtime-agent/
RUN pip install --no-cache-dir --no-deps ./packages/config ./packages/ai-gateway ./backend ./realtime-agent

COPY config/ config/
COPY prompts/ prompts/
# Pre-download models at build time so cold starts are fast.
# Models are baked into the image layer — deterministic, no runtime downloads.
# Bake exact Whisper small model (matching LOCAL_STT_MODEL default) and silero-vad without || true.
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('small', device='cpu', compute_type='int8')"
RUN python -c "import silero_vad; silero_vad.load_silero_vad()"

FROM python:3.11.11-slim AS production

LABEL org.opencontainers.image.source="https://github.com/praxis/interviewOS"
LABEL org.opencontainers.image.description="PRAXIS Realtime WebSocket Agent"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 praxis && useradd -u 10001 -r -g praxis -d /app praxis

WORKDIR /app

COPY --from=source /venv /venv
COPY --from=source /build/packages /app/packages
COPY --from=source /build/backend /app/backend
COPY --from=source /build/realtime-agent /app/realtime-agent
COPY --from=source /build/config /app/config
COPY --from=source /build/prompts /app/prompts

# Copy pre-downloaded ML models with correct ownership so praxis user can read them.
RUN mkdir -p /app/storage /app/.cache
COPY --from=source --chown=praxis:praxis /root/.cache /app/.cache

ENV PATH="/venv/bin:$PATH" \
    PYTHONPATH="/app:$PYTHONPATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080 \
    HF_HOME=/app/.cache/huggingface \
    HF_HUB_OFFLINE=1 \
    XDG_CACHE_HOME=/app/.cache

RUN chown -R praxis:praxis /app

USER praxis

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/health || exit 1

CMD ["sh", "-c", "uvicorn realtime_agent.app.main:app \
    --host 0.0.0.0 \
    --port ${PORT} \
    --workers 1 \
    --timeout-graceful-shutdown 30 \
    --no-access-log"]
