# syntax=docker/dockerfile:1.7
# ── praxis-worker production image (ARQ task queue) ───────────────────────────
# Build context: repository ROOT.
# Workers run: resume processing, embeddings, RAG indexing, debrief generation,
# study cards, analytics, scheduled maintenance.

FROM python:3.11.11-slim AS deps

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    tesseract-ocr \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-lock.txt ./
COPY packages/config/pyproject.toml packages/config/
COPY packages/ai-gateway/pyproject.toml packages/ai-gateway/
COPY backend/pyproject.toml backend/

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip==24.3.1 && \
    pip install --no-cache-dir -r requirements-lock.txt

# Sentence transformers for embeddings.
RUN pip install --no-cache-dir \
    sentence-transformers==3.3.1 \
    torch==2.5.1+cpu \
    --index-url https://download.pytorch.org/whl/cpu

FROM deps AS source

COPY packages/ packages/
COPY backend/ backend/
RUN pip install --no-cache-dir -e packages/config -e packages/ai-gateway -e backend

COPY prompts/ prompts/

FROM python:3.11.11-slim AS production

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    tesseract-ocr \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r praxis && useradd -r -g praxis praxis

WORKDIR /app

COPY --from=source /venv /venv
COPY --from=source /build/packages /app/packages
COPY --from=source /build/backend /app/backend
COPY --from=source /build/prompts /app/prompts

ENV PATH="/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER praxis

# Workers do not expose HTTP — no HEALTHCHECK needed; Cloud Run uses startup probe.
# ARQ workers shut down cleanly on SIGTERM by default.
CMD ["python", "-m", "arq", "backend.worker_settings.WorkerSettings"]
