# syntax=docker/dockerfile:1.7
# ── praxis-worker production image (ARQ task queue) ───────────────────────────
# Build context: repository ROOT.
# Workers run: resume processing, embeddings, RAG indexing, debrief generation,
# study cards, analytics, scheduled maintenance.

FROM python:3.11.11-slim AS deps

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    tesseract-ocr \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements/worker.lock ./requirements-lock.txt
COPY packages/config/pyproject.toml packages/config/
COPY packages/ai-gateway/pyproject.toml packages/ai-gateway/
COPY backend/pyproject.toml backend/

RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip==24.3.1 && \
    pip install --no-cache-dir --require-hashes -r requirements-lock.txt

FROM deps AS source

COPY packages/ packages/
COPY backend/ backend/
RUN pip install --no-cache-dir --no-deps ./packages/config ./packages/ai-gateway ./backend

COPY prompts/ prompts/

FROM python:3.11.11-slim AS production

LABEL org.opencontainers.image.source="https://github.com/praxis/interviewOS"
LABEL org.opencontainers.image.description="PRAXIS Background ARQ Worker"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    tesseract-ocr \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 praxis && useradd -u 10001 -r -g praxis -d /app praxis

WORKDIR /app

COPY --from=source /venv /venv
COPY --from=source /build/packages /app/packages
COPY --from=source /build/backend /app/backend
COPY --from=source /build/prompts /app/prompts

ENV PATH="/venv/bin:$PATH" \
    PYTHONPATH="/app:$PYTHONPATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

USER praxis

EXPOSE 8080

# Cloud Run / container healthcheck hitting worker's HTTP health listener
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/health || exit 1

# Workers expose port 8080 health listener via WorkerSettings.on_startup
CMD ["python", "-m", "arq", "backend.worker_settings.WorkerSettings"]
